# ── Stripe Price IDs ──────────────────────────────────────────────────────────
# Create these in Stripe Dashboard → Products → Add product
# Each tier needs TWO prices: one one-time (setup) + one recurring (monthly)

# Foundation — $1,500 setup / $99/mo
STRIPE_PRICE_FOUNDATION_SETUP=price_...
STRIPE_PRICE_FOUNDATION_MONTHLY=price_...

# Broadcast — $3,000 setup / $135/mo
STRIPE_PRICE_BROADCAST_SETUP=price_...
STRIPE_PRICE_BROADCAST_MONTHLY=price_...

# Network — $5,000 setup / $175/mo
STRIPE_PRICE_NETWORK_SETUP=price_...
STRIPE_PRICE_NETWORK_MONTHLY=price_...

